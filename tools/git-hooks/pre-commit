#!/usr/bin/env bash
# Protect: committed approved chapters, assembled manuscripts, and SUPERSEDED drafts.
# The current (highest-numbered) draft of a chapter may be edited in place (author, 2026-10-15).
# Override only with author permission: ALLOW_APPROVED_CHANGE=1 git commit ...
[ "${ALLOW_APPROVED_CHANGE:-0}" = "1" ] && exit 0
bad=""
while IFS=$'\t' read -r status path1 path2; do
  for path in "$path1" ${path2:+"$path2"}; do
    case "$path" in
      chapters/*/approved.md|manuscript/*)
        [ "$path" = "manuscript/README.md" ] || bad="$bad\n$status $path" ;;
      chapters/*/draft-v[0-9]*.md)
        case "$path" in *-notes.md) continue ;; esac
        dir=$(dirname "$path"); n=$(basename "$path" | sed -E 's/draft-v([0-9]+)\.md/\1/')
        max=$(ls "$dir" 2>/dev/null | sed -n -E 's/^draft-v([0-9]+)\.md$/\1/p' | sort -n | tail -1)
        [ -n "$max" ] && [ "$n" -lt "$max" ] && bad="$bad\n$status $path (superseded by draft-v$max.md)" ;;
    esac
  done
done < <(git diff --cached --name-status --diff-filter=MDR)
if [ -n "$bad" ]; then
  printf 'BLOCKED: this commit changes protected files:%b\n' "$bad" >&2
  echo "Approved text, manuscripts, and superseded drafts are immutable (CLAUDE.md §6)." >&2
  exit 1
fi
exit 0
